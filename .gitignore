# ============================================================
# IBM Cloud Terraform DriftGuard AI — .gitignore
# ============================================================

# Environment / secrets — NEVER commit
.env
*.env
.env.*

# Drift fingerprint state
.driftguard/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
*.tfplan
crash.log
crash.*.log
*.tfvars
!terraform.tfvars.example
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# macOS
.DS_Store

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
